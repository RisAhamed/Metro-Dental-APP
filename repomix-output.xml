        {/* Groups */}
        <div className="bg-white rounded-lg shadow p-6">
          <h3 className="font-medium text-gray-700 mb-4">Groups</h3>
          {availableGroups.length > 0 && (
            <div className="flex flex-wrap gap-2">
              {availableGroups.map((group) => (
                <button
                  key={group.id}
