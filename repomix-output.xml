                  <tr key={cor.correctionId} className="hover:bg-gray-50">
                    <td className="px-4 py-3 text-sm text-gray-900">{cor.dateString}</td>
                    <td className="px-4 py-3 text-sm text-gray-500">
                      {cor.requestType.replace(/_/g, ' ')}
