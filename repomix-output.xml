                  <div>
                    <label className="block text-xs font-medium text-gray-500 mb-1">Procedure Status</label>
                    <select
                      value={proc.status || 'PENDING'}
                      onChange={(e) => updateProcedure(idx, { status: e.target.value as PlanProcedure['status'] })}
